{
  "name": "agentura",
  "private": true,
  "type": "module",
  "scripts": {
    "p0": "tsx src/p0/run.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lab": "npm run -s lab:build && tsx lab/server.ts",
    "lab:build": "esbuild lab/editor-entry.js --bundle --format=esm --minify --outfile=lab/public/vendor/cm.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@types/node": "^26.6.6",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
