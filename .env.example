# Справжня модель для лабораторії — НЕОБОВ'ЯЗКОВО.
# Без цього файлу всі уроки працюють на заготовлених відповідях.
#
# Як увімкнути: скопіюй цей файл у .env (`cp .env.example .env`), розкоментуй ОДИН варіант
# і перезапусти `npm run lab`. Файл .env у git не потрапляє — ключі лишаються в тебе.

# ── Варіант 1. Локально і безкоштовно — Ollama ─────────────────────────────
# Нічого вписувати не треба: постав Ollama (ollama.com), зроби `ollama pull qwen3:8b`
# — і лабораторія знайде її сама. Рядки нижче — лише якщо хочеш конкретну модель або іншу адресу.
# OLLAMA_MODEL=qwen3:8b   # «думання» лабораторія вимикає сама; моделі 4B часто кидають задачу на півдорозі
# OLLAMA_URL=http://127.0.0.1:11434

# ── Варіант 2. Хмарний OpenAI-сумісний API (часто є безкоштовний ліміт) ─────
# Ключ береш на сайті сервісу. Назву моделі — теж там (вони часто змінюються).
# Ліміти й умови безкоштовних тарифів перевір на сайті: вони бувають невеликі.
#
# OpenRouter:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=
#
# Groq:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=
#
# Google Gemini (AI Studio):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_API_KEY=
# OPENAI_MODEL=
#
# Якщо тариф платний — постав false, і лабораторія не писатиме «безкоштовно»:
# OPENAI_FREE=true

# ── Варіант 3. Claude від Anthropic (платно, копійки за урок) ─────────────────
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
